<?xml version="1.0" ?>
<!--
Rough, non-photorealistic scene for the beverage disposal project: a low
table next to the arm's base, a can and a bottle sitting on it, and an open
bin nearby. All primitives, no meshes/Fuel models needed. Dimensions favor
staying within the OpenManipulator-X's short reach over realism.
-->
<sdf version="1.6">
  <world name="beverage_disposal_world">
    <!-- No explicit system plugins here on purpose. gz-sim's implicit default
    set (Physics, SceneBroadcaster, UserCommands) already covers everything
    this world needs. An explicit Sensors plugin was tried here for a native
    lidar-based ultrasonic sensor, but Gazebo's sensor rendering pipeline
    proved unreliable on this VM's virtual GPU (crashes, or silently produced
    no topic data, across several render engine combinations); see CLAUDE.md.
    Switched to computing the ultrasonic reading from Gazebo pose data in a
    plain ROS2 node instead, which needs no sensor system plugin at all. -->

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low table (solid box, not hollow) within the arm's reach -->
    <model name="table">
      <static>true</static>
      <pose>0.22 0 0.075 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.2 1</ambient>
            <diffuse>0.55 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bin: open-top box made of 5 walls, sitting on the ground -->
    <model name="bin">
      <static>true</static>
      <pose>-0.05 -0.28 0 0 0 0</pose>
      <link name="bin_link">
        <collision name="bin_floor_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box><size>0.25 0.25 0.01</size></box>
          </geometry>
        </collision>
        <visual name="bin_floor_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box><size>0.25 0.25 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <collision name="bin_wall_neg_x_collision">
          <pose>-0.12 0 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.3</size></box></geometry>
        </collision>
        <visual name="bin_wall_neg_x_visual">
          <pose>-0.12 0 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <collision name="bin_wall_pos_x_collision">
          <pose>0.12 0 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.3</size></box></geometry>
        </collision>
        <visual name="bin_wall_pos_x_visual">
          <pose>0.12 0 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <collision name="bin_wall_neg_y_collision">
          <pose>0 -0.12 0.15 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.3</size></box></geometry>
        </collision>
        <visual name="bin_wall_neg_y_visual">
          <pose>0 -0.12 0.15 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <collision name="bin_wall_pos_y_collision">
          <pose>0 0.12 0.15 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.3</size></box></geometry>
        </collision>
        <visual name="bin_wall_pos_y_visual">
          <pose>0 0.12 0.15 0 0 0</pose>
          <geometry><box><size>0.25 0.01 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Can: short, wide cylinder on the table (roughly a 12oz soda can) -->
    <model name="can">
      <pose>0.22 0.06 0.211 0 0 0</pose>
      <link name="can_link">
        <inertial>
          <mass>0.014</mass>
          <inertia>
            <ixx>2.0e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.0e-05</iyy><iyz>0</iyz>
            <izz>7.6e-06</izz>
          </inertia>
        </inertial>
        <collision name="can_collision">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.122</length></cylinder>
          </geometry>
        </collision>
        <visual name="can_visual">
          <geometry>
            <cylinder><radius>0.033</radius><length>0.122</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.8 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bottle: taller, narrower cylinder with a small neck, also on the table -->
    <model name="bottle">
      <pose>0.22 -0.06 0.25 0 0 0</pose>
      <link name="bottle_link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>7.0e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.0e-05</iyy><iyz>0</iyz>
            <izz>1.4e-05</izz>
          </inertia>
        </inertial>
        <collision name="bottle_body_collision">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="bottle_body_visual">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.15 0.8</ambient>
            <diffuse>0.1 0.4 0.15 0.8</diffuse>
          </material>
        </visual>
        <collision name="bottle_neck_collision">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.012</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="bottle_neck_visual">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.012</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.15 0.8</ambient>
            <diffuse>0.1 0.4 0.15 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
