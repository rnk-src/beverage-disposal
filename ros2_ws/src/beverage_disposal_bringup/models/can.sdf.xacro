<?xml version="1.0"?>
<!-- The can, spawned separately from the static world file (see
     worlds/beverage_disposal_world.sdf's pointer comment) so its mass can
     be chosen at launch time; see classification.py for why (Iteration
     4, fullness classification from the can's real simulated mass).

     ros_gz_sim's create tool, run with its -string flag, requires a
     complete SDF document, not a bare model fragment (confirmed by
     reading its source, ros_gz_sim/src/create.cpp: FLAGS_string is passed
     straight to req.set_sdf(...)), which is why this is a whole <sdf>
     file rather than just the <model> block moved verbatim. -->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="mass" default="0.014"/>
  <xacro:property name="mass" value="$(arg mass)"/>
  <xacro:property name="radius" value="0.033"/>
  <xacro:property name="length" value="0.122"/>

  <model name="can">
    <!-- This pose is vestigial for a `create -string` spawn: create.cpp
         always builds the spawn pose from its own -x/-y/-z CLI flags
         (each defaulting to 0) and sets it on the request unconditionally,
         which overrides whatever is written here entirely (found live: an
         earlier version of this file with no -x/-y/-z passed at the call
         site spawned the can at the world origin, not here). Kept for
         documentation/readability and in case this file is ever loaded a
         different way (e.g. included directly in a world file again), but
         the real spawn pose lives in whichever launch file calls create,
         as -x 0.26 -y 0.06 -z 0.211; keep both in sync by hand. -->
    <pose>0.26 0.06 0.211 0 0 0</pose>
    <link name="can_link">
      <inertial>
        <mass>${mass}</mass>
        <!-- Empty-mass inertia is pinned to the exact legacy constants
             this world used before this iteration, not derived from the
             formula below. Iteration 3 spent many sessions tuning grasp/
             lift reliability against this exact configuration (see
             commit-notes/10-iteration-3-pick-and-lift.md), and this project
             has already found small physics-parameter changes can matter
             (the kp/kd contact-softness experiment, 0/18 across three
             magnitudes), so there's no reason to risk that for a value
             that's staying the same anyway. Only the new full-mass
             variant's inertia is formula-derived (solid-cylinder
             ixx=iyy=m(3r^2+L^2)/12, izz=m*r^2/2), which is safe since
             nothing depends on that value existing yet. -->
        <xacro:if value="${mass == 0.014}">
          <inertia>
            <ixx>2.0e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.0e-05</iyy><iyz>0</iyz>
            <izz>7.6e-06</izz>
          </inertia>
        </xacro:if>
        <xacro:unless value="${mass == 0.014}">
          <inertia>
            <ixx>${mass * (3 * radius * radius + length * length) / 12}</ixx>
            <ixy>0</ixy><ixz>0</ixz>
            <iyy>${mass * (3 * radius * radius + length * length) / 12}</iyy>
            <iyz>0</iyz>
            <izz>${mass * radius * radius / 2}</izz>
          </inertia>
        </xacro:unless>
      </inertial>
      <collision name="can_collision">
        <geometry>
          <cylinder><radius>${radius}</radius><length>${length}</length></cylinder>
        </geometry>
        <!-- Friction unchanged from the pre-Iteration-4 static model; see
             beverage_disposal_world.sdf's git history / commit-notes/10 for
             the original diagnosis this responded to. -->
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="can_visual">
        <geometry>
          <cylinder><radius>${radius}</radius><length>${length}</length></cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.05 0.05 1</ambient>
          <diffuse>0.8 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
