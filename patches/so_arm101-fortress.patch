       <origin
         xyz="-0.11257 -0.028 1.73763e-16"
@@ -658,6 +728,55 @@
       </actuator>
     </transmission>
 
+    <!-- The moving jaw closes against a fixed prong that's part of
+         gripper_link's own body casting on the real hardware - there's no
+         separate "static jaw" part, and gripper_link's only collision
+         geometry is its two big body meshes, giving no small, specific
+         contact surface. See jaw_pad_link above (on jaw_link) for the
+         full story: someone else solved this exact grip-slipping problem
+         for this exact gripper in MuJoCo by adding small box-primitive
+         contact patches on *both* gripping surfaces, since raw
+         mesh-to-mesh collision produces one unstable contact point
+         regardless of friction. This is the fixed-side half of that pair.
+
+         Position: not derived from jaw geometry (four earlier attempts at
+         that each failed differently - full story in commit-notes/10).
+         Instead, measured the can's own real position relative to
+         gripper_link directly via TF during an actual grasp attempt:
+         (0.0071, 0.0010, -0.1208). Found the closest real vertex on
+         gripper_link's own body meshes to that point by brute-force
+         nearest-neighbor search over the actual mesh triangle data:
+         (-0.0082, -0.0002, -0.1041), about 2.3cm away (close to the can's
+         own radius, so genuinely near the real contact zone). Then, per
+         the working recipe found above, nudged 2mm further along the
+         can-to-mesh-point direction so the pad protrudes only slightly
+         from the existing mesh instead of sitting flush on its surface -
+         disableFixedJointLumping keeps it a separate SDF link so the
+         friction override just below applies only to this small patch. -->
+    <link name="${prefix}fixed_jaw_pad_link">
+      <inertial>
+        <mass value="0.0005" />
+        <inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10" />
+      </inertial>
+      <collision>
+        <origin xyz="0 0 0" rpy="0 0 0" />
+        <geometry>
+          <box size="0.006 0.006 0.006" />
+        </geometry>
+      </collision>
+    </link>
+    <joint name="${prefix}fixed_jaw_pad_joint" type="fixed">
+      <origin xyz="-0.0095 -0.0003 -0.1026" rpy="0 0 0" />
+      <parent link="${prefix}gripper_link" />
+      <child link="${prefix}fixed_jaw_pad_link" />
+      <axis xyz="0 0 0" />
+      <disableFixedJointLumping>true</disableFixedJointLumping>
+    </joint>
+    <gazebo reference="${prefix}fixed_jaw_pad_link">
+      <mu1>2.0</mu1>
+      <mu2>2.0</mu2>
+    </gazebo>
+
     <!-- Fixed joint for gripper frame -->
     <joint name="${prefix}gripper_frame_joint" type="fixed">
       <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0" />
@@ -673,6 +792,23 @@
       <child link="${prefix}jaw_link" />
       <axis xyz="0 0 1" />
       <limit effort="10" velocity="10" lower="0.0" upper="1.70" />
+      <!-- jaw_link's mass (0.012 kg) gives this joint an inertia around
+           6.6e-6 kg*m^2, roughly three orders of magnitude below the
+           arm's other joints. With zero physical damping (the vendored
+           default), any nonzero commanded effort accelerates it to its
+           10 rad/s velocity limit in well under one millisecond, and with
+           no friction to dissipate energy, it never settles on its own,
+           see commit-notes/10 for the full diagnosis (direct per-cycle
+           logging of effort/velocity/position showed the joint pinned at
+           its velocity limit on essentially every control cycle,
+           regardless of control-loop rate or gain). A real gripper joint
+           always has some viscous damping from its own mechanics; this
+           vendored model simply omits it. Adding a small, physically
+           plausible damping value here lets the physics engine dissipate
+           energy every simulation timestep (1ms), far faster than any
+           ROS2/Python control loop could react, which is what actually
+           makes closed-loop position holding possible for this joint. -->
+      <dynamics damping="0.05" friction="0.0" />
     </joint>
 
