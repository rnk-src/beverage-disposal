diff --git a/so_arm101_description/urdf/so_arm101_macro.xacro b/so_arm101_description/urdf/so_arm101_macro.xacro
index 1116cbd..c42341b 100644
--- a/so_arm101_description/urdf/so_arm101_macro.xacro
+++ b/so_arm101_description/urdf/so_arm101_macro.xacro
@@ -528,6 +528,37 @@
       </collision>
     </link>
 
+    <!-- No friction was specified anywhere on the gripper before this
+         iteration, so every jaw-object contact ran on Gazebo/DART's raw
+         physics defaults. mu1/mu2 here are the URDF/SDF-extension
+         shorthand for the same ODE surface-friction coefficients used on
+         the can's collision (beverage_disposal_world.sdf), applying to
+         every collision in the named link at once rather than needing
+         per-collision surface blocks the way plain SDF models do. See
+         commit-notes/10 for the diagnosis this responds to. In short, a
+         can grip was reaching real, sustained squeeze effort but the
+         object still slipped free during a lift, the textbook symptom of
+         friction, not force.
+
+         Only jaw_link (the moving jaw, the part that actually contacts
+         the can) gets this override. An earlier version also applied it
+         to gripper_link, on the theory that the fixed prong the jaw
+         closes against is part of that link's body mesh, but that
+         measurably tanked simulation performance (test_gripper.py's real-time factor
+         collapsed to roughly a fifth of normal, timing the test out even
+         though the joint itself still worked) because gripper_link's
+         collision geometry is the whole servo body and wrist-roll-follower
+         mesh, not just the small patch that ever touches an object, so
+         every one of its many unrelated resting contacts got proportionally
+         more expensive to resolve for the whole simulation, not just the
+         moment of a grasp. Left off pending a scoped fix (e.g. a small,
+         separate collision primitive on just the actual fixed-jaw contact
+         area) rather than paying that global cost for every run. -->
+    <gazebo reference="${prefix}jaw_link">
+      <mu1>3.0</mu1>
+      <mu2>3.0</mu2>
+    </gazebo>
+
     <!-- Joint from base to shoulder -->
     <joint name="${prefix}shoulder_pan_joint" type="revolute">
       <origin
@@ -580,7 +611,7 @@
     </transmission>
 
     <!-- Joint from upper_arm to lower_arm -->
-    <!-- Note: 5-degree calibration offset applied to joint limits -->
+    <!-- 5-degree calibration offset applied to joint limits -->
     <joint name="${prefix}elbow_flex_joint" type="revolute">
       <origin
         xyz="-0.11257 -0.028 1.73763e-16"
@@ -673,6 +704,23 @@
       <child link="${prefix}jaw_link" />
       <axis xyz="0 0 1" />
       <limit effort="10" velocity="10" lower="0.0" upper="1.70" />
+      <!-- jaw_link's mass (0.012 kg) gives this joint an inertia around
+           6.6e-6 kg*m^2, roughly three orders of magnitude below the
+           arm's other joints. With zero physical damping (the vendored
+           default), any nonzero commanded effort accelerates it to its
+           10 rad/s velocity limit in well under one millisecond, and with
+           no friction to dissipate energy, it never settles on its own,
+           see commit-notes/10 for the full diagnosis (direct per-cycle
+           logging of effort/velocity/position showed the joint pinned at
+           its velocity limit on essentially every control cycle,
+           regardless of control-loop rate or gain). A real gripper joint
+           always has some viscous damping from its own mechanics; this
+           vendored model simply omits it. Adding a small, physically
+           plausible damping value here lets the physics engine dissipate
+           energy every simulation timestep (1ms), far faster than any
+           ROS2/Python control loop could react, which is what actually
+           makes closed-loop position holding possible for this joint. -->
+      <dynamics damping="0.05" friction="0.0" />
     </joint>
 
     <transmission name="${prefix}gripper_trans">
