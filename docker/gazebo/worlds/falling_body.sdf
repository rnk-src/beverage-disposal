<?xml version="1.0"?>
<sdf version="1.9">
  <world name="falling_body">
    <physics name="fixed_step" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <!-- No ground plane: the ball is in free fall for the whole run. -->
    <model name="ball">
      <pose>0 0 10 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
